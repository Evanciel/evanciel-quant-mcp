# quant-mcp 라이브 거래 환경변수 (BYOK). 값은 본인 키로 채우고 .env로 복사. 절대 커밋 금지.
# 아무것도 설정 안 하면 전부 페이퍼(가짜돈). 자세한 설명: SETUP-LIVE.md

# ── Binance ──
# BINANCE_ENV=testnet                 # testnet(기본,가짜돈) | live(실돈)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_FUTURES_API_KEY=            # 선물 testnet 키는 현물과 별개(testnet.binancefuture.com)
# BINANCE_FUTURES_API_SECRET=

# ── 한국투자(KIS) ──
# KIS_ENV=mock                        # mock(기본) | live
# KIS_APPKEY=
# KIS_APPSECRET=
# KIS_ACCOUNT=12345678-01             # 계좌번호-상품코드

# ── 키움(Kiwoom) ──
# KIWOOM_ENV=mock                     # mock(기본) | live
# KIWOOM_APPKEY=
# KIWOOM_SECRETKEY=                   # 필드명 secretkey

# ── 토스증권(Toss) — KR+US, OAuth2 client_credentials ──
# ⚠️ 토스는 모의 호스트 없음 → env 기본 live. 주문 쓰기는 LIVE_TRADING_ENABLED=true + 어댑터 하드블록 통과 시에만.
# TOSS_ENV=live                       # live(기본)
# TOSS_CLIENT_ID=                     # WTS > 설정 > Open API 발급 (별칭 TOSS_API_KEY 도 인식)
# TOSS_CLIENT_SECRET=                 # (별칭 TOSS_SECRET_KEY 도 인식)
# TOSS_ACCOUNT_SEQ=                   # 계좌 식별번호(/accounts 조회 — verify-toss-e2e.ts가 출력). 시세·캔들엔 불필요

# ── 메인넷 실거래 마스터 스위치 + 하드리밋 (메인넷에만 필요) ──
# LIVE_TRADING_ENABLED=true           # ★ 없으면 메인넷 차단(페이퍼). 기본 OFF.
# LIVE_MAX_NOTIONAL=200               # 주문당 최대 금액
# LIVE_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT
# 일일 실현손실 서킷 — 통화별 분리(권장, audit P1-6). 우선순위: 분리값 > 단일값 > 통화 기본값(USDT 50 / KRW 75000).
# LIVE_DAILY_LOSS_LIMIT_USDT=50       # Binance(USDT) 일일 손실 한도(달러)
# LIVE_DAILY_LOSS_LIMIT_KRW=75000     # 키움/KIS(KRW) 일일 손실 한도(원)
# LIVE_DAILY_LOSS_LIMIT=100           # (하위호환) 통화 무관 단일값 — 분리값 미설정 시 통화별로 각각 적용

# ── 긴급 정지 / 감사 무결성 (선택) ──
# LIVE_TRADING_HALT=true              # 글로벌 킬스위치 — 모든 주문 즉시 차단(포지션 유지). 텔레그램 /halt와 동일.
# AUDIT_FAILURE_HALT=true             # 감사로그 누적 실패 시 주문 차단(기본 OFF=가용성 우선)
# AUDIT_FAILURE_HALT_MAX=10           # 위 차단 임계(누적 실패 횟수, 기본 10)
# LIVE_PROTECTIVE_FAIL_LIMIT=3        # 보호주문 연속 실패 시 비상청산 임계(1~10, 기본 3)
# LIVE_UNKNOWN_MAX_COUNT=5            # 주문 결과불명 누적 시 강제 reconcile 임계(1~20, 기본 5)

# ── 24/7 데몬 / 원격 제어 (선택, npm run daemon) ──
# QUANT_MCP_DASHBOARD_PORT=7788       # 데몬 대시보드 포트
# ALERT_ENABLED=true                  # Slack/Discord 웹훅 알림
# ALERT_WEBHOOK_URL=                  # Slack(hooks.slack.com)/Discord 웹훅 URL
# ALERT_HEARTBEAT_MINUTES=60          # 데몬 하트비트 주기(채널 침묵=사망 신호, 최소 5)
# TELEGRAM_BOT_TOKEN=                 # 텔레그램 원격제어 봇 토큰(/status /halt /forceexit /resume)
# TELEGRAM_CHAT_IDS=                  # 허용 chat id(쉼표구분, 필수 화이트리스트)

# ── 로컬 데이터 디렉토리(선택) ──
# QUANT_MCP_DATA_DIR=                 # 기본 ~/.quant-mcp
